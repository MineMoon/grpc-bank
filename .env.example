# Скопируйте в .env: cp .env.example .env
# Makefile читает файл как строки KEY=VALUE, поэтому значения без пробелов и #.

# PostgreSQL. POSTGRES_HOST и POSTGRES_PORT нужны сервисам и миграциям.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgresadmin
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
ACCOUNTS_DB_NAME=accounts_db
PAYMENTS_DB_NAME=payments_db

# account-service
ACCOUNT_SERVICE_GRPC_PORT=50051

# payment-service
PAYMENT_SERVICE_GRPC_PORT=50052
ACCOUNT_SERVICE_ADDR=127.0.0.1:50051

# api-gateway
GATEWAY_HTTP_PORT=8080
PAYMENT_SERVICE_ADDR=127.0.0.1:50052

# Полный DSN вместо сборки из POSTGRES_* (необязательно):
# ACCOUNT_SERVICE_DB_URL=postgres://postgres:postgresadmin@127.0.0.1:5432/accounts_db?sslmode=disable
# PAYMENT_SERVICE_DB_URL=postgres://postgres:postgresadmin@127.0.0.1:5432/payments_db?sslmode=disable
